# Environment Variables

# This file contains all environment variables used by the SkillMap frontend.
# Copy this file to .env.local and fill in the values.

# ============================================================================
# API Configuration
# ============================================================================

# Backend API URL (skillmap_engine)
# Production: https://your-backend-domain.com
# Development: http://localhost:5005
NEXT_PUBLIC_BACKEND_URL=http://localhost:5005

# Frontend API base URL (usually just /api for Next.js API routes)
NEXT_PUBLIC_API_URL=/api

# ============================================================================
# API Request Configuration
# ============================================================================

# Timeout for API requests in milliseconds (default: 30000 = 30 seconds)
NEXT_PUBLIC_API_TIMEOUT=30000

# Maximum number of retries for failed requests (default: 3)
NEXT_PUBLIC_MAX_RETRIES=3

# Delay between retries in milliseconds (default: 1000 = 1 second)
NEXT_PUBLIC_RETRY_DELAY=1000

# ============================================================================
# Supabase Configuration
# ============================================================================

# Supabase Project URL
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url_here

# Supabase Anonymous Public Key
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# ============================================================================
# Feature Flags (Optional)
# ============================================================================

# Enable debug logging
NEXT_PUBLIC_DEBUG=false

# Enable error tracking (e.g., Sentry)
NEXT_PUBLIC_ENABLE_ERROR_TRACKING=false

# ============================================================================
# Development Settings (Optional)
# ============================================================================

# Enable mock data in development
NEXT_PUBLIC_USE_MOCK_DATA=false

# Bypass authentication in development (NOT for production!)
NEXT_PUBLIC_BYPASS_AUTH=false
